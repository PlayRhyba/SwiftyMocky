fastlane_version "2.51.0"

default_platform :ios

platform :ios do
    desc "Runs all the tests"
    lane :test do
        scan(
            scheme: "Mocky_Tests_iOS",
            project: "./SwiftyMocky.xcodeproj",
            devices: ["iPhone 16"]
        )
    end
end

